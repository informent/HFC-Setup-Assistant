<Window x:Class="HfcSetupAssistant.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="HFC Setup Assistant" Height="940" Width="1440" MinHeight="760" MinWidth="1080"
 Background="#F3F6F8" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <DataTemplate x:Key="EntryTemplate"><Border Background="#F5F8FA" CornerRadius="6" Padding="5,5,8,5" Margin="0,0,0,5"><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding}" Click="RemoveEntry_Click" MinHeight="30" Padding="8,3" Margin="8,0,0,0"/><TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0"><Run Text="{Binding Destination}" FontWeight="SemiBold"/><Run Text="  →  "/><Run Text="{Binding Value}"/><Run Text=" "/><Run Text="{Binding Unit}"/><Run Text="  ·  "/><Run Text="{Binding Basis}" Foreground="#657386"/></TextBlock></DockPanel></Border></DataTemplate>
  <DataTemplate x:Key="PilotEntryTemplate"><Border Background="#F5F8FA" CornerRadius="6" Padding="9,6" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Destination}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="1" TextWrapping="Wrap"><Run Text="{Binding Value}"/><Run Text=" "/><Run Text="{Binding Unit}"/></TextBlock><TextBlock Grid.Column="2" Text="{Binding Basis}" Foreground="#657386" FontSize="11" TextWrapping="Wrap"/></Grid></Border></DataTemplate>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#152936" Padding="24,15">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="HFC SETUP ASSISTANT" Foreground="#9FD5D4" FontSize="12" FontWeight="Bold"/><TextBlock Text="Field readings and Pilot reference" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="New job" Click="NewJob_Click"/><Button Content="New LE job" Click="NewLineExtenderJob_Click"/><Button Content="Open…" Click="Open_Click"/><Button Content="Save job" Click="Save_Click"/><Button Content="Export CSV" Click="Export_Click" Background="#B6E3D3" Foreground="#12312A" BorderThickness="0"/>
    </StackPanel>
   </Grid>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E6EC" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="New local session · no amplifier connection" Foreground="#536272"/></StatusBar>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="24,20" MaxWidth="1390" HorizontalAlignment="Center">
    <Border Style="{StaticResource Card}" Padding="18,14">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0"><TextBlock Text="Equipment" FontSize="12" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="EquipmentType" SelectedIndex="0" SelectionChanged="EquipmentType_Changed"><ComboBoxItem Content="Trunk"/><ComboBoxItem Content="Line extender"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Equipment model" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="EquipmentModel" TextChanged="InputChanged"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,14,0"><TextBlock Text="Node / address / asset ID" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="AssetId" TextChanged="InputChanged"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="Profile" FontSize="12" Foreground="{StaticResource MutedBrush}"/><DockPanel><ComboBox x:Name="ProfilePicker" SelectionChanged="ProfilePicker_Changed"/><Button Content="New profile" Click="NewProfile_Click" MinHeight="38" Padding="9,5"/><Button Content="Save profile" Click="SaveProfile_Click" MinHeight="38" Padding="9,5" Margin="0"/></DockPanel></StackPanel>
     </Grid>
    </Border>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.03*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.97*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <DockPanel><StackPanel><TextBlock Text="Forward target check" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Compare your meter readings with the selected work profile." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,16"/></StackPanel><Border DockPanel.Dock="Right" Background="#E8F2F3" CornerRadius="12" Padding="10,5" Height="28"><TextBlock Text="MANUAL MEASUREMENTS" FontSize="10" Foreground="#176A70" FontWeight="Bold"/></Border></DockPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Low frequency (MHz)"/><TextBox x:Name="LowFrequency" Margin="0,5,0,10" TextChanged="InputChanged"/><TextBlock Text="Low reading (dBmV)"/><TextBox x:Name="LowReading" Margin="0,5,0,0" TextChanged="InputChanged"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="High frequency (MHz)"/><TextBox x:Name="HighFrequency" Margin="0,5,0,10" TextChanged="InputChanged"/><TextBlock Text="High reading (dBmV)"/><TextBox x:Name="HighReading" Margin="0,5,0,0" TextChanged="InputChanged"/></StackPanel>
        </Grid>
        <TextBlock Text="Measurement point / reference plane" Margin="0,10,0,0"/><TextBox x:Name="MeasurementPoint" Margin="0,5,0,0" TextChanged="InputChanged"/>
        <Border Background="#F5F8FA" CornerRadius="8" Padding="12" Margin="0,15,0,0">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="NOMINAL LOW" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="NominalLow" Text="28 dBmV" FontSize="17" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="NOMINAL HIGH" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="NominalHigh" Text="38 dBmV" FontSize="17" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="TARGET TILT" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="NominalTilt" Text="10 dB" FontSize="17" FontWeight="SemiBold"/></StackPanel>
         </Grid>
        </Border>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Low error" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LowError" Text="—" FontSize="19" FontWeight="SemiBold"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="High error" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HighError" Text="—" FontSize="19" FontWeight="SemiBold"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Actual tilt" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ActualTilt" Text="—" FontSize="19" FontWeight="SemiBold"/></StackPanel>
         <StackPanel Grid.Column="3"><TextBlock Text="Tilt error" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TiltError" Text="—" FontSize="19" FontWeight="SemiBold"/></StackPanel>
        </Grid>
        <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border x:Name="LowStatusCard" Background="#EEF1F3" CornerRadius="7" Padding="10"><TextBlock x:Name="LowStatus" Text="LOW · Incomplete" FontWeight="SemiBold"/></Border>
         <Border x:Name="HighStatusCard" Grid.Column="1" Background="#EEF1F3" CornerRadius="7" Padding="10" Margin="8,0"><TextBlock x:Name="HighStatus" Text="HIGH · Incomplete" FontWeight="SemiBold"/></Border>
         <Border x:Name="TiltStatusCard" Grid.Column="2" Background="#EEF1F3" CornerRadius="7" Padding="10"><TextBlock x:Name="TiltStatus" Text="TILT · Incomplete" FontWeight="SemiBold"/></Border>
        </Grid>
        <Border x:Name="OverallCard" Background="#EEF1F3" CornerRadius="7" Padding="12" Margin="0,9,0,0"><TextBlock x:Name="OverallStatus" Text="Enter both readings to check all limits." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
        <TextBlock Text="Limits are inclusive and profile-specific. Levels are dBmV; tilt and errors are dB." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="Work profile" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Editable local defaults. Save the profile to keep changes." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,13"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Profile name"/><TextBox x:Name="ProfileName" Margin="0,4,0,8" TextChanged="ProfileEdited"/><TextBlock Text="Nominal low target (dBmV)"/><TextBox x:Name="ProfileLowTarget" Margin="0,4,0,8" TextChanged="ProfileEdited"/><TextBlock Text="Low accepted range (dBmV)"/><DockPanel Margin="0,4,0,0"><TextBox x:Name="LowMinimum" TextChanged="ProfileEdited"/><TextBlock Text="to" Margin="6,0"/><TextBox x:Name="LowMaximum" TextChanged="ProfileEdited"/></DockPanel><TextBlock Text="Tilt accepted range (dB)" Margin="0,8,0,0"/><DockPanel Margin="0,4,0,0"><TextBox x:Name="TiltMinimum" TextChanged="ProfileEdited"/><TextBlock Text="to" Margin="6,0"/><TextBox x:Name="TiltMaximum" TextChanged="ProfileEdited"/></DockPanel></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Nominal high target (dBmV)"/><TextBox x:Name="ProfileHighTarget" Margin="0,4,0,8" TextChanged="ProfileEdited"/><TextBlock Text="High accepted range (dBmV)"/><DockPanel Margin="0,4,0,0"><TextBox x:Name="HighMinimum" TextChanged="ProfileEdited"/><TextBlock Text="to" Margin="6,0"/><TextBox x:Name="HighMaximum" TextChanged="ProfileEdited"/></DockPanel><Border Background="#F7F4E8" CornerRadius="7" Padding="10" Margin="0,15,0,0"><TextBlock Text="28 / 38 dBmV are work targets only. This check does not decide CATVisor Pilot target fields." TextWrapping="Wrap" Foreground="#6D5721"/></Border></StackPanel>
        </Grid>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <DockPanel><StackPanel><TextBlock Text="Pilot reference" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Four-column Pilot fields in the supplied order. Line extender defaults are user-provided." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,13"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Apply LE entry set" Click="LineExtenderPreset_Click"/><Button Content="Load screenshot example" Click="Example_Click" Margin="0"/></StackPanel></DockPanel>
        <DataGrid x:Name="PilotGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="41" MinHeight="248" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" SelectionUnit="Cell" GridLinesVisibility="Horizontal" BorderBrush="#E0E6EC" CellEditEnding="PilotGrid_CellEditEnding">
         <DataGrid.Columns>
          <DataGridTextColumn Header="PILOT FIELD" Binding="{Binding Label}" IsReadOnly="True" Width="105"/>
          <DataGridTextColumn Header="FREQ MHz" Binding="{Binding FrequencyMhz, UpdateSourceTrigger=PropertyChanged}" Width="82"/>
          <DataGridTextColumn Header="TYPE" Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="57"/>
          <DataGridTextColumn Header="STEP dB" Binding="{Binding StepDownDb, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
          <DataGridTextColumn Header="MEASURED dBmV" Binding="{Binding MeasuredDbmv, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
          <DataGridTextColumn Header="TARGET dBmV" Binding="{Binding ConfiguredTargetDbmv, UpdateSourceTrigger=PropertyChanged}" Width="98"/>
          <DataGridTextColumn Header="DELTA dB" Binding="{Binding DeviationDb}" IsReadOnly="True" Width="80"/>
          <DataGridTextColumn Header="CALC. INPUT* dBmV" Binding="{Binding CalcInputDbmv, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="* Calc. Input is an observed/manual reference only; no formula is applied. “U” is preserved as shown; its meaning is not assumed." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
        <Border Background="#F5F8FA" CornerRadius="7" Padding="11" Margin="0,12,0,0"><StackPanel><TextBlock Text="Preceding amplifier target levels" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="PrecedingReferenceText" Text="The standard line extender entry set has not been applied." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
        <TextBlock Text="Values to enter" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,6"/>
        <TextBlock x:Name="EntryGuidance" Text="Select Line extender to load the user-confirmed manual entry set." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,7"/>
        <ItemsControl x:Name="EntryValuesList" ItemTemplate="{StaticResource PilotEntryTemplate}"/>
        <Border Background="#FFF7E5" BorderBrush="#EBDDAF" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,5,0,0"><TextBlock Text="Manual reference only. No values are sent to the amplifier. Calculated Pilot values remain unavailable until the exact equipment model and procedure are verified." Foreground="#6D5721" TextWrapping="Wrap"/></Border>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="Supervisor-approved manual entries" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Record an approved entry set for your own reference. This app does not program equipment." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.6*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="EntryDestination" ToolTip="Exact destination field" Margin="0,0,8,0"/><TextBox x:Name="EntryValue" Grid.Column="1" ToolTip="Approved value" Margin="0,0,8,0"/><TextBox x:Name="EntryUnit" Grid.Column="2" ToolTip="Unit" Margin="0,0,8,0"/><Button Grid.Column="3" Content="Add" Click="AddEntry_Click"/>
        </Grid>
        <ItemsControl x:Name="EntriesList" Margin="0,10,0,0"/>
        <TextBlock Text="Notes" Margin="0,8,0,0"/><TextBox x:Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top" Margin="0,4,0,0" TextChanged="InputChanged"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
    <TextBlock Text="Offline tool · no account, cloud service, CATVisor connection, or amplifier control" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,12"/>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
